        -96
      ],
      "id": "095fa7c5-4270-4044-b27a-278a9b61e342",
      "name": "Build Failure"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst log = body.message || \"\";\n\nconst guests = [];\n\n// Find the summary table\nconst tableMatch = log.match(/VMID[\\s\\S]*?Filename[\\s\\S]*?\\n([\\s\\S]*?)\\n\\nTotal running time:/);\n\nif (tableMatch) {\n\n    const rows = tableMatch[1].trim().split(\"\\n\");\n\n    for (const row of rows) {\n\n        const m = row.match(/^(\\d+)\\s+(.+?)\\s+(ok|error|failed|warning)\\s+(.+?)\\s+([0-9.]+\\s(?:MiB|GiB|TiB))/);\n\n        if (m) {\n\n            guests.push({\n                vmid: m[1],\n                name: m[2].trim(),\n                status: m[3],\n                duration: m[4].trim(),\n                size: m[5]\n            });\n\n        }\n\n    }\n\n}\n\nconst pruned =\n    log.match(/pruned (\\d+) backup/)?.[1] ?? \"0\";\n\nreturn [{\n    hostname: body.fields.hostname,\n    severity: body.severity,\n    title: body.title,\n    message: body.message,\n    timestamp: body.timestamp,\n    guests,\n    guestCount: guests.length,\n    pruned\n}];"
      },
      "type": "n8n-nodes-base.code",
