    {
      "parameters": {
        "jsCode": "let msg = \"\";\n\nmsg += \"🟢 *Proxmox Backup Successful*\\n\\n\";\n\nmsg += `🖥️ Node: ${$json.hostname}\\n`;\nmsg += `📦 Guests: ${$json.guestCount}\\n\\n`;\n\nfor (const g of $json.guests) {\n\n    msg += `✅ *${g.name}* (${g.vmid})\\n`;\n    msg += `⏱ Duration : ${g.duration}\\n`;\n    msg += `💾 Size     : ${g.size}\\n\\n`;\n\n}\n\nmsg += `🧹 Pruned Backups : ${$json.pruned}\\n`;\n\nmsg += \"\\n━━━━━━━━━━━━━━━━━━\";\n\nreturn [{\n    telegramMessage: msg\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [432, 96],
      "id": "fcc57b8d-a1f9-414e-992d-c142d424fe43",
      "name": "Build Success"
    },
    {
      "parameters": {
        "jsCode": "let msg = \"\";\n\nmsg += \"🔴 *PROXMOX BACKUP FAILED*\\n\\n\";\n\nmsg += `🖥️ Node : ${$json.hostname}\\n\\n`;\n\nmsg += `${$json.title}\\n\\n`;\n\nreturn [{\n    telegramMessage: msg\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [432, -96],
      "id": "095fa7c5-4270-4044-b27a-278a9b61e342",
      "name": "Build Failure"
    },
    {
      "parameters": {
        "jsCode": "const body=$json.body;\nconst log=body.message||\"\";\nconst guests=[];\nconst tableMatch=log.match(/VMID[\\s\\S]*?Filename[\\s\\S]*?\\n([\\s\\S]*?)\\n\\nTotal running time:/);\nif(tableMatch){\nconst rows=tableMatch[1].trim().split(\"\\n\");\nfor(const row of rows){\nconst m=row.match(/^(\\d+)\\s+(.+?)\\s+(ok|error|failed|warning)\\s+(.+?)\\s+([0-9.]+\\s(?:MiB|GiB|TiB))/);\nif(m){\nguests.push({\nvmid:m[1],\nname:m[2].trim(),\nstatus:m[3],\nduration:m[4].trim(),\nsize:m[5]\n});\n}\n}\n}\nconst pruned=log.match(/pruned (\\d+) backup/)?.[1]??\"0\";\nreturn [{\nhostname:body.fields.hostname,\nseverity:body.severity,\ntitle:body.title,\nmessage:body.message,\ntimestamp:body.timestamp,\nguests,\nguestCount:guests.length,\npruned\n}];"
      },
